Content-Type: application/json
Accept: application/json

{
  "title": "Try .http file",
  "description": "Created from VS Code/Visual Studio HTTP client",
  "isCompleted": false,
  "dueDate": null
}

###
PUT {{TaskApi_HostAddress}}/api/tasks/1
Content-Type: application/json
Accept: application/json

{
  "title": "Updated title",
  "description": "Updated via PUT",
  "isCompleted": true,
  "dueDate": null
}

###
DELETE {{TaskApi_HostAddress}}/api/tasks/1
Accept: application/json

